{
    "app-id": "io.photoflare.photoflare",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.7",
    "sdk": "org.kde.Sdk",
    "command": "photoflare",
    "modules": [
        {
            "name": "graphicsmagick",
            "builddir": true,
            "config-opts": [
                "--enable-shared",
                "--with-modules",
                "--with-perl",
                "--with-quantum-depth=16",
                "--with-threads"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/project/graphicsmagick/graphicsmagick/1.3.46/GraphicsMagick-1.3.46.tar.xz",
                    "sha256": "c7c706a505e9c6c3764156bb94a0c9644d79131785df15a89c9f8721d1abd061"
                }
            ]
        },
        {
            "name": "fftw3",
            "buildsystem": "autotools",
            "config-opts": [
                "--enable-shared",
                "--enable-threads",
                "--enable-openmp"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://fftw.org/fftw-3.3.10.tar.gz",
                    "sha256": "56c932549852cddcfafdab3820b0200c7742675be92179e59e6215b340e26467"
                }
            ]
        },
        {
            "name": "gmic-qt",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "wget --no-check-certificate --quiet -O gmic/src/CImg.h https://github.com/GreycLab/CImg/raw/v.3.7.5/CImg.h",
                "LATEST_VER=$(git ls-remote --tags --refs https://github.com/GreycLab/gmic.git 'v.*' | sed 's|.*refs/tags/v\\.||' | grep -E '^[0-9]+\\.[0-9]+\\.[0-9]+$' | sort -V | tail -n1 | tr -d '.') && test -n \"$LATEST_VER\" && wget --quiet -O gmic/src/gmic_stdlib_community.h \"https://gmic.eu/gmic_stdlib_community${LATEST_VER}.h\" && grep -q data_gmic gmic/src/gmic_stdlib_community.h",
                "cmake . -B _build -DBUILD_WITH_QT6=ON -DGMIC_QT_HOST=none -DENABLE_SYSTEM_GMIC=OFF -DGMIC_PATH=/run/build/gmic-qt/gmic/src -DENABLE_FFTW3=ON -DENABLE_CURL=ON -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXE_LINKER_FLAGS=-no-pie",
                "cmake --build _build --parallel 1",
                "cmake --install _build --prefix /app",
                "mv /app/bin/gmic_qt /app/bin/gmic_photoflare_qt"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/c-koi/gmic-qt.git",
                    "commit": "aa4a6f4ab174b37fcdf4df5f94fde0898856523a",
                    "tag": "v.3.4.2"
                },
                {
                    "type": "git",
                    "url": "https://github.com/GreycLab/gmic.git",
                    "dest": "gmic",
                    "commit": "57137ee00ba76bafe63f3ab759ea9b7b1d1edf0f",
                    "tag": "v.3.7.5"
                }
            ]
        },
        {
            "name": "photoflare",
            "buildsystem": "qmake",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/PhotoFlare/photoflare.git",
                    "commit": "7c6a966"
                }
            ]
        }
    ]
}
